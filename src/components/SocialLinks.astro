---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class:list={['social-links', className]}>
  <a href="https://twitter.com/astrodotbuild" target="_blank">
    <span class="sr-only">Download Jeff Miller's Resume</span>
    <svg
      viewBox="0 0 16 16"
      aria-hidden="true"
      width="24"
      height="24"
      astro-icon="social/resume"
    >
      <path
        fill="currentColor"
        d="M8 1.333H4.083A1.417 1.417 0 0 0 2.667 2.75v10.5a1.416 1.416 0 0 0 1.416 1.417h7.834a1.417 1.417 0 0 0 1.416-1.417V6.667H9.417A1.417 1.417 0 0 1 8 5.25zm5.209 4.5c-.071-.156-.17-.299-.29-.42L9.254 1.747a1.4 1.4 0 0 0-.421-.29V5.25c0 .322.261.583.583.583z"
      ></path>
    </svg>
  </a>
  <a href="https://www.linkedin.com/in/jamiller619/" target="_blank">
    <span class="sr-only">Follow Jeff Miller on LinkedIn</span>
    <svg
      viewBox="0 0 16 16"
      aria-hidden="true"
      width="24"
      height="24"
      astro-icon="social/linkedin"
    >
      <path
        fill-rule="evenodd"
        fill="currentColor"
        d="M.667 1.892A1.227 1.227 0 0 1 1.892.667h12.215a1.225 1.225 0 0 1 1.226 1.225v12.215a1.226 1.226 0 0 1-1.226 1.226H1.892a1.226 1.226 0 0 1-1.225-1.226zm5.805 4.367h1.986v.997c.287-.573 1.02-1.09 2.122-1.09 2.113 0 2.613 1.143 2.613 3.238v3.881h-2.138V9.881c0-1.193-.286-1.866-1.014-1.866-1.01 0-1.43.726-1.43 1.866v3.404H6.472zm-3.667 6.935h2.139V6.167H2.805zm2.445-9.32a1.375 1.375 0 1 1-2.75.061 1.375 1.375 0 0 1 2.75-.06"
        clip-rule="evenodd"
      ></path>
    </svg>
  </a>
  <a href="https://github.com/jamiller619" target="_blank">
    <span class="sr-only">Go to Jeff Miller's GitHub</span>
    <svg
      viewBox="0 0 16 16"
      aria-hidden="true"
      width="24"
      height="24"
      astro-icon="social/github"
    >
      <path
        fill="currentColor"
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-1.04 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
      ></path>
    </svg>
  </a>
</div>

<style>
  .social-links {
    display: flex;
    gap: 1em;

    a {
      text-decoration: none;
      color: currentColor;
      transition: color 0.3s ease;

      &:hover {
        color: lch(from currentColor l c h / 50%);
      }
    }
  }
</style>
