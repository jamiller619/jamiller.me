---
import SocialLinks from './SocialLinks.astro'

const today = new Date()
---

<footer>
  <a class="email" href="mailto:hello@jamiller.me">hello@jamiller.me</a>
  <SocialLinks />
  <span class="copyright">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none">
      <path
        fill="currentColor"
        d="M8 1.333C4.387 1.333 1.333 4.387 1.333 8S4.387 14.667 8 14.667 14.667 11.613 14.667 8 11.613 1.333 8 1.333m0 12c-2.893 0-5.333-2.44-5.333-5.333S5.107 2.667 8 2.667 13.333 5.107 13.333 8 10.893 13.333 8 13.333"
      ></path><path
        fill="currentColor"
        d="M8 6c.66 0 1.233.173 1.527.473l.94-.94c-.747-.746-1.874-.86-2.474-.86a3.335 3.335 0 0 0 0 6.667c.6 0 1.72-.113 2.474-.86l-.94-.947c-.294.294-.867.474-1.527.474-1.087 0-2-.914-2-2 0-1.087.913-2 2-2z"
      ></path>
    </svg>
    <span
      >2017 &mdash; {today.getFullYear()} Jeff Miller. All rights reserved.</span
    >
  </span>
</footer>
<style>
  footer {
	position: relative;
	z-index: 1;
	pointer-events: none;
    padding: 2em 1em 6em 1em;
  }

  footer :global(a) {
	pointer-events: auto;
  }

  .email {
    text-decoration: none;
    color: currentColor;
    font-size: 4rem;
    font-weight: bold;
    letter-spacing: -0.05em;
  }

  .copyright {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    font-size: smaller;
  }
</style>
